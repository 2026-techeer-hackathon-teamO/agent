# 로그를 전송할 backend 주소
BACKEND_URL=http://localhost:8000

# 이 PC 식별자 (비우면 hostname 자동 사용)
HOST=

# 감시할 디렉터리 (쉼표 구분). 예: C:\Users\me\Documents,D:\
# 비우면 로그인 사용자의 프로필 폴더를 감시 (연결된 USB 드라이브는 자동 추가)
WATCH_PATHS=

# 기밀로 간주할 파일명/경로 키워드 (쉼표 구분, 대소문자 무시)
CONFIDENTIAL_KEYWORDS=기밀,대외비,confidential,secret

# 기밀로 간주할 확장자 (쉼표 구분, 비우면 미적용)
CONFIDENTIAL_EXTENSIONS=

# backend X-Agent-Key. backend .env 의 AGENT_API_KEY 와 같은 값 (비밀값, 커밋 금지)
# 비우면 디코이 배치 비활성
AGENT_API_KEY=

# 디코이 배치 폴더. 비우면 로그인 사용자의 Downloads 폴더
DECOY_DIR=

# 배치한 디코이 기록 파일. 비우면 Windows: %ProgramData%\dlp-agent\decoy_state.json, 그 외: ./decoy_state.json
DECOY_STATE_FILE=

# 디코이 동기화 주기(초)
DECOY_POLL_INTERVAL=60

# 이보다 큰 파일은 해시 생략 (바이트, 기본 500MB)
HASH_MAX_BYTES=524288000

# 같은 파일의 연속 이벤트를 묶는 시간(초)
EVENT_DEBOUNCE_SECONDS=2
